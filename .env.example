# Copy to .env.local. Never prefix server secrets with NEXT_PUBLIC_.
# Supabase project API settings (publishable key is safe for browser use).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

OPENROUTER_API_KEY=
# Exact OpenRouter ID: paid and free models are supported.
# Example paid model: openai/gpt-oss-20b (requires credits).
OPENROUTER_MODEL=openrouter/free
# Supabase is the default. Only for isolated local development/tests:
# NEWS_STORAGE=sqlite
# NEWS_DATABASE_PATH=./data/news.sqlite
NEWS_SCAN_LIMIT=3
# Leave blank for the built-in same-origin API.
NEXT_PUBLIC_BACKEND=
# Supabase sessions protect the API. Leave this legacy extra token unset for the UI.
# NEWS_API_TOKEN=
